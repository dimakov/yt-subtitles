{
  "manifest_version": 3,
  "name": "Subtitle Downloader for YouTube",
  "version": "1.0.1",
  "description": "Download YouTube subtitles and auto-generated captions as SRT, VTT, TXT or JSON, optionally auto-translated.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Download subtitles",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["page/page-api.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
